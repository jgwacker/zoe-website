---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sectionLabel } from '../lib/site-nav.mjs';

const { title = 'Untitled', description = '' } = Astro.props;
const eyebrow = sectionLabel(Astro.url.pathname);
const hasHero = Astro.slots.has('hero');
const hasSidebar = Astro.slots.has('sidebar');
const longTitle = String(title).length > 40;
---
<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <Header />
    <section class="title-band">
      <div class="band-inner">
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        <h1 class:list={['post-title', longTitle ? 'long-title' : 'script']}>{title}</h1>
      </div>
    </section>
    {hasHero && (
      <div class="hero-band">
        <slot name="hero" />
      </div>
    )}
    <main class="container">
      <div class:list={['layout', { 'no-sidebar': !hasSidebar }]}>
        {hasSidebar && (
          <aside class="sidebar">
            <slot name="sidebar" />
          </aside>
        )}
        <section class="content">
          <slot />
        </section>
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .title-band { padding: 56px 16px 32px; border-bottom: 1px solid var(--hair); }
  .band-inner { width: var(--page-max); max-width: 100%; margin: 0 auto; }
  .post-title {
    font-size: clamp(52px, 8vw, 112px);
    line-height: 1.05;
    margin: 14px 0 0;
    padding-bottom: .08em;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .post-title.long-title { font-family: var(--serif); font-variation-settings: var(--soft); font-weight: 500; color: var(--deep-rose); font-size: clamp(32px, 4.4vw, 56px); line-height: 1.1; }
  .hero-band { padding: 48px 16px 24px; }
  .layout { display: grid; grid-template-columns: minmax(200px, 260px) minmax(0, 1fr); gap: 56px; }
  .layout.no-sidebar { grid-template-columns: minmax(0, 1fr); }
  .sidebar { position: sticky; top: 88px; align-self: start; }
  .content { min-width: 0; }
  @media (max-width: 900px) {
    .title-band { padding: 36px 16px 24px; }
    .hero-band { padding: 32px 16px 8px; }
    .layout { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .sidebar { position: static; }
  }
</style>
