---
import Layout from '@layouts/Page.astro';
import LinkList from '@components/LinkList.astro';
import { photographyAwards } from '@links/registry';
import AwardExhibit from '@components/AwardExhibit.astro';
---

<Layout title="The Shelter: National Photography Competition for Kids June 2026">
  <LinkList slot="sidebar" items={photographyAwards} orientation="vertical" />

  <AwardExhibit slot="hero"
    image="/images/photography_awards/npcfk-shelter-2026.jpg"
    alt="Two king penguins standing side by side on golden grass, one flipper overlapping the other."
    title="The Shelter" year={2026} result="Notable Entry"
    place="Patagonia, Chile"
    contest="National Photography Competition for Kids, June 2026"
    division="Rising Photographers, ages 12–14" />

  <p class="intro">
I entered "The Shelter" National Photography Competition for Kids in the Rising Photographers section for ages
12 to 14. I submitted my photo of two king penguins standing side by side in Patagonia, and it was selected as a
Notable Entry.
  </p>

  <figure class="photo">
    <img
      src="/images/photography_awards/nation-junion-phographers.png"
      alt="National Photography Competition for Kids logo"
      width="1600"
      height="1067"
      loading="lazy"
      decoding="async"
    />
    <figcaption>The official competition logo</figcaption>
  </figure>


  <p>
    See the <a href="https://www.junior-photographers.com/notable-entries/the-shelter-national-photography-competition-for-kids/page/2/">official notable entries page</a>.
  </p>
</Layout>
