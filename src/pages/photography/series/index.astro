---
import Layout from '@layouts/Page.astro';
import LinkList from '@components/LinkList.astro';
import { photographySections } from '@links/registry';
import series from '/src/data/series.json';

const drafts = series.filter((s) => s.draft).map((s) => s.title);
if (drafts.length) console.warn(`[series] draft statements still to rewrite: ${drafts.join(', ')}`);
---
<Layout title="Photography — Series">
  <LinkList slot="sidebar" items={photographySections} orientation="vertical" />

  <p class="intro">Ten-photo series I'm developing, each built around one idea rather than one place.</p>

  <div class="series">
    {series.map((s) => (
      <a class="set" href={`/photography/series/${s.slug}/`}>
        <figure>
          <img src={s.overview} alt={`The ten photos of ${s.title}`} loading="lazy" decoding="async" />
          <figcaption><span class="name">{s.title}</span></figcaption>
        </figure>
      </a>
    ))}
  </div>

  <style>
    .series { display: grid; gap: 1.5rem; }
    .set { display: block; text-decoration: none; color: inherit; }
    .set figure { margin: 0; }
    .set img { display: block; width: 100%; height: auto; }
    .name { font-family: var(--display); font-size: 1.4rem; letter-spacing: 0.02em; color: var(--cream); }
    .set:hover .name { color: var(--marigold); }
  </style>
</Layout>
