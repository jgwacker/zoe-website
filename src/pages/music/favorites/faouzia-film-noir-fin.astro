---
import Layout from '@layouts/Page.astro';
import LinkList from '@components/LinkList.astro';
import { musicFavorites } from '@links/registry';
---
<Layout title="Faouzia — FILM NOIR (fin)">
  <LinkList slot="sidebar" items={musicFavorites} orientation="vertical" />
  <p><em>FILM NOIR (fin)</em> is the expanded edition of Faouzia’s debut album, <em>FILM NOIR</em>, which came out in November 2025. The new edition, released in June 2026, adds three new songs, including the single “BIRTHDAY.” Faouzia is a Moroccan-Canadian singer, and the album is cinematic alt-pop sung in English, French, and Arabic.</p>
</Layout>
